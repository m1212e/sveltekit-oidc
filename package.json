{
	"name": "@m1212e/sveltekit-oidc",
	"version": "0.0.41",
	"license": "Apache-2.0",
	"description": "A SvelteKit library for OpenID Connect (OIDC) authentication.",
	"repository": {
		"type": "git",
		"url": "https://github.com/m1212e/sveltekit-oidc"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack_",
		"preview": "vite preview",
		"prepare_": "svelte-kit sync || echo ''",
		"prepack_": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.9.1",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"publint": "^0.3.21",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.13"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"jose": "^6.2.3",
		"openid-client": "^6.8.4",
		"typebox": "^1.1.38"
	}
}
